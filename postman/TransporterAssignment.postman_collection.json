{
  "info": {
    "name": "Transporter Assignment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"}
  ],
  "item": [
    {
      "name": "Submit Input Data",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/transporters/input",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lanes\": [\n    {\"id\": 1, \"origin\": \"Mumbai\", \"destination\": \"Delhi\"},\n    {\"id\": 2, \"origin\": \"Delhi\", \"destination\": \"Bangalore\"},\n    {\"id\": 3, \"origin\": \"Chennai\", \"destination\": \"Kolkata\"},\n    {\"id\": 4, \"origin\": \"Pune\", \"destination\": \"Hyderabad\"},\n    {\"id\": 5, \"origin\": \"Ahmedabad\", \"destination\": \"Jaipur\"}\n  ],\n  \"transporters\": [\n    {\"id\": 1, \"name\": \"Transporter T1\", \"laneQuotes\": [\n      {\"laneId\": 1, \"quote\": 5000}, {\"laneId\": 2, \"quote\": 6000}]},\n    {\"id\": 2, \"name\": \"Transporter T2\", \"laneQuotes\": [\n      {\"laneId\": 3, \"quote\": 7000}, {\"laneId\": 4, \"quote\": 4000}]},\n    {\"id\": 3, \"name\": \"Transporter T3\", \"laneQuotes\": [\n      {\"laneId\": 5, \"quote\": 3000}]}\n  ]\n}"
        }
      }
    },
    {
      "name": "Get Optimized Assignment",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/transporters/assignment",
        "body": {"mode": "raw", "raw": "{\"maxTransporters\": 3}"}
      }
    },
    {
      "name": "Invalid Input Test",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/transporters/input",
        "body": {"mode": "raw", "raw": "{\"lanes\": [], \"transporters\": []}"}
      }
    },
    {
      "name": "No Feasible Assignment Test",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/transporters/input",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lanes\": [\n    {\"id\": 1, \"origin\": \"A\", \"destination\": \"B\"},\n    {\"id\": 2, \"origin\": \"C\", \"destination\": \"D\"}\n  ],\n  \"transporters\": [\n    {\"id\": 1, \"name\": \"T1\", \"laneQuotes\": [{\"laneId\": 1, \"quote\": 100}]}\n  ]\n}"
        }
      }
    },
    {
      "name": "Maximum Transporter Limit Test",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/v1/transporters/assignment",
        "body": {"mode": "raw", "raw": "{\"maxTransporters\": 1}"}
      }
    }
  ]
}
